# ==================================================
# CIVICSHIELD AI CONFIGURATION
# ==================================================

# Database Connection
# SQLite for zero-setup local dev/testing: sqlite:///./civicshield.db
# PostgreSQL + PostGIS: postgresql://postgres:postgres@localhost:5432/civicshield
DATABASE_URL=sqlite:///./civicshield.db

# Security & Session Authentication
SECRET_KEY=civicshield-development-secret-key-change-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Network & URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000

# File Upload Storage
UPLOAD_DIRECTORY=./uploads
MAX_UPLOAD_SIZE=10485760

# RoadWatch AI - Computer Vision Model
# If VISION_MODEL_PATH is empty or not found, system operates in manual observation mode.
# To configure YOLOv8/ONNX weights, set the absolute or relative path to .pt / .onnx file.
VISION_MODEL_PATH=
VISION_MODEL_NAME=roadwatch-cv-v1

# Optional Cloud LLM Provider (Google Gemini)
# The application runs 100% functional without an API key using deterministic rules.
# Set LLM_PROVIDER=gemini and provide LLM_API_KEY to activate cloud natural language synthesis.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# External Weather & Alert Providers
EXTERNAL_ALERT_PROVIDER=simulated
EXTERNAL_ALERT_API_KEY=

# Platform Demonstration Mode
DEMO_MODE_DEFAULT=true
